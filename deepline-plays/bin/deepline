#!/usr/bin/env sh
# Deepline plugin bootstrap. Claude Code and Cowork put plugin bin/ entries on
# PATH, so this makes `deepline ...` work before any user-level CLI install
# exists. The real CLI is installed through the canonical Deepline installer.
set -e

INSTALL_URL="${DEEPLINE_CLI_INSTALL_URL:-https://code.deepline.com/api/v2/sdk/install}"
INSTALL_DIR="${DEEPLINE_INSTALL_DIR:-$HOME/.local/bin}"
REAL="$INSTALL_DIR/deepline"
CLI_FAMILY="${DEEPLINE_PLUGIN_CLI_FAMILY:-plays}"
CLI_FAMILY_MARKER="$INSTALL_DIR/.deepline-plugin-family"
PLUGIN_BIN_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)"
PLUGIN_ROOT="$(CDPATH= cd -- "$PLUGIN_BIN_DIR/.." 2>/dev/null && pwd -P)"

export DEEPLINE_PLUGIN_MODE="${DEEPLINE_PLUGIN_MODE:-true}"
export DEEPLINE_PLUGIN_ROOT="${DEEPLINE_PLUGIN_ROOT:-$PLUGIN_ROOT}"
if [ -d "$PLUGIN_ROOT/skills" ]; then
  export DEEPLINE_PLUGIN_SKILLS_DIR="${DEEPLINE_PLUGIN_SKILLS_DIR:-$PLUGIN_ROOT/skills}"
fi

resolve_workspace_dir() {
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -d "$CLAUDE_PROJECT_DIR" ]; then
    printf '%s\n' "$CLAUDE_PROJECT_DIR"
    return 0
  fi

  case "${HOME:-}" in
    /sessions/*) ;;
    *)
      case "${CLAUDE_CODE_REMOTE:-}" in
        1|true|TRUE|yes|YES|on|ON) ;;
        *) return 0 ;;
      esac
      ;;
  esac

  if [ ! -d "$HOME/mnt" ]; then
    return 0
  fi

  if [ -d "$HOME/mnt/deepline" ]; then
    printf '%s\n' "$HOME/mnt/deepline"
    return 0
  fi

  for candidate in "$HOME"/mnt/*/; do
    [ -d "$candidate" ] || continue
    basename="${candidate%/}"
    basename="${basename##*/}"
    case "$basename" in
      .*|outputs|uploads) continue ;;
    esac
    printf '%s\n' "${candidate%/}"
    return 0
  done
}

export_workspace_api_key() {
  workspace_dir="$(resolve_workspace_dir)"
  if [ -z "$workspace_dir" ]; then
    return 0
  fi

  workspace_env="$workspace_dir/.deepline/.env"
  if [ ! -f "$workspace_env" ]; then
    return 0
  fi

  # Parse as data, never source. The workspace is user/repo-controlled.
  while IFS='=' read -r key value; do
    case "$key" in
      DEEPLINE_API_KEY)
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"
        export DEEPLINE_API_KEY="$value"
        return 0
        ;;
    esac
  done < "$workspace_env"
}

install_canonical_cli() {
  if [ "$0" = "$REAL" ]; then
    echo "deepline: refusing to bootstrap recursively from $REAL" >&2
    exit 127
  fi

  if curl -fsSL "$INSTALL_URL" | \
    DEEPLINE_INSTALLER_MODE=true \
    DEEPLINE_INSTALLER_SKIP_AUTH=true \
    DEEPLINE_INSTALLER_SKIP_PATH=true \
    DEEPLINE_INSTALLER_SKIP_QUICKSTART=true \
    DEEPLINE_INSTALLER_SKIP_AGENT_SKILL_INSTALL=true \
    DEEPLINE_INSTALL_DIR="$INSTALL_DIR" \
    sh; then
    mkdir -p "$INSTALL_DIR"
    printf '%s\n' "$CLI_FAMILY" > "$CLI_FAMILY_MARKER"
    return 0
  fi

  echo "deepline: failed to install CLI from $INSTALL_URL" >&2
  exit 127
}

export_workspace_api_key

installed_family=""
if [ -f "$CLI_FAMILY_MARKER" ]; then
  installed_family="$(sed -n '1p' "$CLI_FAMILY_MARKER" 2>/dev/null || true)"
elif [ "$CLI_FAMILY" = "legacy" ] && [ -x "$REAL" ]; then
  installed_family="legacy"
fi

if [ ! -x "$REAL" ] || [ "$installed_family" != "$CLI_FAMILY" ]; then
  install_canonical_cli
fi

if [ ! -x "$REAL" ]; then
  echo "deepline: installer completed but $REAL is not executable" >&2
  exit 127
fi

exec "$REAL" "$@"
