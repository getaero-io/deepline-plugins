#!/usr/bin/env sh
# Deepline CLI shim. Execs the cached Python shiv. Self-healing: if the shiv
# isn't present (cold cache, ephemeral cloud sandbox, or SessionStart hook
# didn't fire), fetch it inline before exec.
set -e

CACHE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/deepline-plugin"
CACHE_DIR="$CACHE_ROOT/cli"
SHIV="$CACHE_DIR/deepline.pyz"

if [ ! -x "$SHIV" ]; then
  mkdir -p "$CACHE_DIR"
  TMP="$(mktemp "${TMPDIR:-/tmp}/deepline-shiv.XXXXXX")"
  if curl -fsSL "https://code.deepline.com/api/v2/cli/python" -o "$TMP"; then
    chmod +x "$TMP"
    mv "$TMP" "$SHIV"
  else
    rm -f "$TMP"
    echo "deepline: failed to fetch CLI shiv from https://code.deepline.com/api/v2/cli/python" >&2
    exit 127
  fi
fi

# Cross-session auth persistence for ephemeral sandboxes (e.g. Cowork).
# If a workspace .env exists, source it so DEEPLINE_API_KEY survives across
# fresh sandbox sessions. The workspace folder is bind-mounted from the
# user's local machine and persists across cloud sandbox teardowns.
WORKSPACE_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
WORKSPACE_ENV="$WORKSPACE_DIR/.deepline/.env"
if [ -f "$WORKSPACE_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$WORKSPACE_ENV"
  set +a
fi

# Match the standalone bash installer's env wiring so behavior is identical
# whether the user has both installs or just the plugin.
export DEEPLINE_API_BASE_URL="${DEEPLINE_API_BASE_URL:-https://code.deepline.com}"
export DEEPLINE_CONFIG_SCOPE="${DEEPLINE_CONFIG_SCOPE:-code-deepline-com}"
export DEEPLINE_INSTALL_METHOD="${DEEPLINE_INSTALL_METHOD:-shiv}"
export DEEPLINE_REAL_BINARY="${DEEPLINE_REAL_BINARY:-$SHIV}"

exec "$SHIV" "$@"
