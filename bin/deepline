#!/usr/bin/env sh
# TEST BRANCH: bundled shiv at vendor/deepline.pyz overrides the prod-fetch path.
# Used to validate iterations of CLI error messages and auth flow without
# shipping deepline-api releases. Reverts to fetch-from-prod on main.
set -e

# Resolve plugin root from script location (works under Cowork's /sessions/<id>/mnt/...).
PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUNDLED_SHIV="$PLUGIN_ROOT/vendor/deepline.pyz"

# Cross-session auth persistence in ephemeral sandboxes.
WORKSPACE_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
WORKSPACE_ENV="$WORKSPACE_DIR/.deepline/.env"
if [ -f "$WORKSPACE_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$WORKSPACE_ENV"
  set +a
fi

# Match the standalone bash installer's env wiring so behavior is identical
# whether the user has both installs or just the plugin. Test build talks to
# prod for auth (api.deepline.com) — only the binary itself is local.
export DEEPLINE_API_BASE_URL="${DEEPLINE_API_BASE_URL:-https://code.deepline.com}"
export DEEPLINE_CONFIG_SCOPE="${DEEPLINE_CONFIG_SCOPE:-code-deepline-com}"
export DEEPLINE_INSTALL_METHOD="${DEEPLINE_INSTALL_METHOD:-shiv}"
export DEEPLINE_REAL_BINARY="${DEEPLINE_REAL_BINARY:-$BUNDLED_SHIV}"
# Don't let self-update overwrite the bundled shiv during testing.
export DEEPLINE_SKIP_SELF_UPDATE="${DEEPLINE_SKIP_SELF_UPDATE:-1}"

exec "$BUNDLED_SHIV" "$@"
