#!/usr/bin/env sh
# TEST BRANCH: fetches shiv from ngrok-tunneled local dev server.
# This lets us iterate on CLI error messages without committing binaries.
# Reverts to fetch-from-prod on main.
set -e

CACHE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/deepline-plugin"
CACHE_DIR="$CACHE_ROOT/cli"
SHIV="$CACHE_DIR/deepline.pyz"

# Test-only fetch URL — points at the local dev server through ngrok.
SHIV_FETCH_URL="${DEEPLINE_TEST_SHIV_URL:-https://6ead-136-36-246-228.ngrok-free.app/deepline.pyz}"

if [ ! -x "$SHIV" ]; then
  mkdir -p "$CACHE_DIR"
  TMP="$(mktemp "${TMPDIR:-/tmp}/deepline-shiv.XXXXXX")"
  if curl -fsSL "$SHIV_FETCH_URL" -o "$TMP"; then
    chmod +x "$TMP"
    mv "$TMP" "$SHIV"
  else
    rm -f "$TMP"
    echo "deepline: failed to fetch CLI shiv from $SHIV_FETCH_URL" >&2
    exit 127
  fi
fi

# Cross-session auth persistence in ephemeral sandboxes.
WORKSPACE_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
WORKSPACE_ENV="$WORKSPACE_DIR/.deepline/.env"
if [ -f "$WORKSPACE_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$WORKSPACE_ENV"
  set +a
fi

# TEST BRANCH: route CLI traffic through the ngrok tunnel so the bundled
# dev-server code (e.g. snowflake worktree) drives the test, not prod.
export DEEPLINE_API_BASE_URL="${DEEPLINE_API_BASE_URL:-https://6ead-136-36-246-228.ngrok-free.app}"
# Distinct config scope keeps test auth state from colliding with prod.
export DEEPLINE_CONFIG_SCOPE="${DEEPLINE_CONFIG_SCOPE:-ngrok-test}"
export DEEPLINE_INSTALL_METHOD="${DEEPLINE_INSTALL_METHOD:-shiv}"
export DEEPLINE_REAL_BINARY="${DEEPLINE_REAL_BINARY:-$SHIV}"
# Keep the test shiv stable — don't let prod self-update overwrite it.
export DEEPLINE_SKIP_SELF_UPDATE="${DEEPLINE_SKIP_SELF_UPDATE:-1}"

exec "$SHIV" "$@"
