#!/usr/bin/env sh
# Deepline CLI shim. Execs the cached Python shiv. Self-healing: if the shiv
# isn't present (cold cache, ephemeral cloud sandbox, or SessionStart hook
# didn't fire), fetch it inline before exec.
set -e

CACHE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/deepline-plugin"
CACHE_DIR="$CACHE_ROOT/cli"
SHIV="$CACHE_DIR/deepline.pyz"

SHIV_FETCH_URL="${DEEPLINE_CLI_FETCH_URL:-https://code.deepline.com/api/v2/cli/python}"

if [ ! -x "$SHIV" ]; then
  mkdir -p "$CACHE_DIR"
  TMP="$(mktemp "${TMPDIR:-/tmp}/deepline-shiv.XXXXXX")"
  if curl -fsSL "$SHIV_FETCH_URL" -o "$TMP"; then
    chmod +x "$TMP"
    mv "$TMP" "$SHIV"
  else
    rm -f "$TMP"
    echo "deepline: failed to fetch CLI shiv from $SHIV_FETCH_URL" >&2
    exit 127
  fi
fi

# Cross-session auth persistence in cloud sandboxes (Cowork, claude.ai/code).
# Resolution order matches the CLI's _resolve_remote_workspace_dir:
#   1. $CLAUDE_PROJECT_DIR (laptop and possibly future Cowork)
#   2. $HOME/mnt/deepline/ if present (deterministic if user named workspace 'deepline')
#   3. $HOME/mnt/<workspace>/ — first non-system, non-dot dir under $HOME/mnt/
#      (skips .claude, .remote-plugins, outputs, uploads)
WORKSPACE_DIR="${CLAUDE_PROJECT_DIR:-}"
if [ -z "$WORKSPACE_DIR" ] && [ -n "${HOME:-}" ] && [ -d "$HOME/mnt" ]; then
  case "$HOME" in
    /sessions/*)
      if [ -d "$HOME/mnt/deepline" ]; then
        WORKSPACE_DIR="$HOME/mnt/deepline"
      else
        for _candidate in "$HOME"/mnt/*/; do
          [ -d "$_candidate" ] || continue
          _basename="${_candidate%/}"
          _basename="${_basename##*/}"
          case "$_basename" in
            .*|outputs|uploads) continue ;;
          esac
          WORKSPACE_DIR="${_candidate%/}"
          break
        done
      fi
      ;;
  esac
fi
if [ -n "$WORKSPACE_DIR" ] && [ -f "$WORKSPACE_DIR/.deepline/.env" ]; then
  # Parse as data, NEVER source. The workspace is user/repo-controlled, so
  # sourcing would let a malicious .deepline/.env execute arbitrary shell via
  # $(...) or backticks in the value. Only DEEPLINE_API_KEY is supported here;
  # any other lines are ignored.
  while IFS='=' read -r _dl_key _dl_value; do
    case "$_dl_key" in
      DEEPLINE_API_KEY)
        # Strip surrounding quotes (we never write them, but be tolerant).
        _dl_value="${_dl_value%\"}"; _dl_value="${_dl_value#\"}"
        _dl_value="${_dl_value%\'}"; _dl_value="${_dl_value#\'}"
        export DEEPLINE_API_KEY="$_dl_value"
        ;;
    esac
  done < "$WORKSPACE_DIR/.deepline/.env"
  unset _dl_key _dl_value
fi

# Match the standalone bash installer's env wiring so behavior is identical
# whether the user has both installs or just the plugin. Notably aligns the
# config scope so auth state is shared with the standalone CLI on machines
# that have both.
export DEEPLINE_API_BASE_URL="${DEEPLINE_API_BASE_URL:-https://code.deepline.com}"
export DEEPLINE_CONFIG_SCOPE="${DEEPLINE_CONFIG_SCOPE:-code-deepline-com}"
export DEEPLINE_INSTALL_METHOD="${DEEPLINE_INSTALL_METHOD:-shiv}"
export DEEPLINE_REAL_BINARY="${DEEPLINE_REAL_BINARY:-$SHIV}"

exec "$SHIV" "$@"
